{
    "name": "Vicario Development - Java 21 (targets Java 8)",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "runArgs": ["--platform=linux/amd64"],
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",

    "mounts": [
        "source=${localWorkspaceFolder}/settings.xml,target=/root/.m2/settings.xml,type=bind,readonly",
        "source=vicario-maven-repo,target=/root/.m2/repository,type=volume"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "vscjava.vscode-maven",
                "redhat.java",
                "vscjava.vscode-java-debug",
                "vscjava.vscode-java-test",
                "ms-azuretools.vscode-docker"
            ],
            "settings": {
                "java.jdt.ls.java.home": "/opt/java/openjdk",
                "maven.executable.path": "/usr/share/maven/bin/mvn",
                "java.configuration.runtimes": [
                    {
                        "name": "JavaSE-21",
                        "path": "/opt/java/openjdk",
                        "default": true
                    }
                ],
                "java.debug.settings.hotCodeReplace": "auto",
                "java.compile.nullAnalysis.mode": "disabled",
                "files.watcherExclude": {
                    "**/target/**": true,
                    "**/.m2/**": true
                }
            }
        }
    },

    "remoteEnv": {
        "JAVA_HOME": "/opt/java/openjdk",
        "MAVEN_HOME": "/usr/share/maven",
        "DISPLAY": "${localEnv:DISPLAY}"
    },

    "postCreateCommand": "mvn package dependency:copy-dependencies -DoutputDirectory=target/dependency -DincludeScope=runtime -DskipTests && cp .devcontainer/vicario.sh /usr/local/bin/vicario && echo 'Build complete. Use: vicario <args>'",

    "forwardPorts": [5005, 5006],

    "portsAttributes": {
        "5005": {
            "label": "Java Debug (Primary)",
            "onAutoForward": "silent"
        },
        "5006": {
            "label": "Java Debug (Alternate)",
            "onAutoForward": "silent"
        }
    }
}
